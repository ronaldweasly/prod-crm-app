# SolarCRM local-first setup

NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
VITE_USE_MOCK=false
VITE_API_PROXY_TARGET=http://localhost:4000

# Local auth and local database
# The first server start creates this admin if the local data file is empty.
ADMIN_EMAIL=admin@solarcrm.local
ADMIN_PASSWORD=admin12345
ADMIN_NAME=Local Admin
JWT_SECRET=change-this-to-a-long-random-string
SESSION_EXPIRY=7d
BCRYPT_ROUNDS=12

# Local database file. Leave blank to use:
# infrastructure/backend/data/solarcrm.local.json
LOCAL_DB_PATH=

# Cloudflare R2 file storage
# Files go to R2; CRM records and users stay in the local database above.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=solarcrm-files
R2_PUBLIC_URL=

# Optional AI features
GEMINI_API_KEY=
